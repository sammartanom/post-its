{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pufsd-dlc-living-questions",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "upload_source_maps": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
